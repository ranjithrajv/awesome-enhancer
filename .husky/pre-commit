#!/usr/bin/env bash
set -e

# Pre-commit hook — matches GitHub Actions CI (bun.yml)
# Steps here correspond 1-to-1 with CI jobs; keep them in sync.

echo "🔍 Running pre-commit checks (mirroring GitHub Actions CI)..."
echo ""

# 1. Security audit (CI: bun.yml)
echo "✓ Running security audit..."
bun tools/security/audit-gate.mjs --level high

# 2. Version check (release requirement)
echo "✓ Checking version consistency..."
bun --filter='@awesome-enhancer/core' run check-version

# 3. Tests (CI: bun.yml)
echo "✓ Running tests with coverage..."
bun run test:coverage

# 4. Type checking (CI: bun.yml, release.yml)
echo "✓ Running typecheck..."
bun run typecheck

# 5. Linting (CI: bun.yml, release.yml)
echo "✓ Running lint..."
bun run lint:all

# 6. Build + bundle verification (CI: bun.yml, pages.yml)
echo "✓ Running build (includes web bundle verification)..."
bun run build

# 7. Formatting check (CI: implicit in code quality)
echo "✓ Checking formatting..."
bun run format --check

# 8. Dead code/unused exports check (CI: code quality)
echo "✓ Checking for unused code (knip)..."
bunx knip --exclude dependencies,unlisted,binaries

# 9. E2E smoke test (CI: bun.yml e2e job)
echo "✓ Running E2E smoke test..."
bun run dev --help > /dev/null

echo ""
echo "✅ All pre-commit checks passed!"
echo "🚀 Ready to commit!"
