{
  "name": "awesome-enhancer-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@awesome-enhancer/cli' dev",
    "dev:server": "bun run --filter='@awesome-enhancer/http-server' dev",
    "dev:mcp": "bun run --filter='@awesome-enhancer/mcp-server' dev",
    "build": "bun run --filter='@awesome-enhancer/*' build",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint",
    "lint:all": "bun run --filter='@awesome-enhancer/*' lint",
    "format": "prettier --write .",
    "typecheck": "bun run --filter='@awesome-enhancer/*' typecheck",
    "clean": "bun run --filter='@awesome-enhancer/*' clean",
    "clean:all": "bun run clean && rm -rf node_modules packages/*/node_modules",
    "audit": "bun audit"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "tinypool": "^2.1.2",
    "picomatch": "^2.3.2",
    "source-map-js": "^1.2.2",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.7",
    "path-to-regexp": "^8.4.0",
    "hono": "^4.12.25",
    "axios": "^1.20.0",
    "http-cache-semantics": "^4.2.1",
    "ip-address": "^10.3.1",
    "@fastify/busboy": "^3.2.1",
    "brace-expansion": "^1.1.21"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.41.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vite-plus": "^0.1.11",
    "vitest": "^4.1.12"
  },
  "dependencies": {}
}
